!/nvim/lua/plugins/lsp.lua
!/nvim/lua/plugins/telescope.lua
!/nvim/lua/plugins/ui.lua
!/nvim/stylua.toml

# Shell configuration (no history or completion caches)
!/zsh/
!/zsh/.zshenv
!/zsh/.zshrc
!/zsh/aliases.zsh

# Download helper (no downloads or archives)
!/yt-dlp/
!/yt-dlp/download-playlist.sh

# Intentionally NOT allowed:
# gh/hosts.yml: authentication; git/config.local: machine-local settings.
# git/config: currently contains a personal email and machine-specific signing settings.
# nvm/: installed runtime; go/: telemetry; ubuntu-insights/: local consent.
# Shell history, logs, caches, credentials, downloads, and unknown new files.
# To add a file, allow its parent directories and then its exact path above.
