# Shareable application settings
!/bob/
!/bob/config.json
!/gh/
!/gh/config.yml
!/git/
!/git/config.local.template
!/git/ignore
!/sheldon/
!/sheldon/plugins.toml
!/tmux/
!/tmux/tmux.conf

# Manual
!/manual/
!/manual/index.html

# Neovim configuration and plugin lockfile
!/nvim/
!/nvim/.gitignore
!/nvim/README.md
!/nvim/init.lua
!/nvim/lazy-lock.json
!/nvim/lua/
!/nvim/lua/config/
!/nvim/lua/config/autocmds.lua
!/nvim/lua/config/keymaps.lua
!/nvim/lua/config/lazy.lua
!/nvim/lua/config/options.lua
!/nvim/lua/config/treesitter-parsers.lua
